#!/usr/bin/env bash

# -------------------------------------------------------------------------------- #
# Description                                                                      #
# -------------------------------------------------------------------------------- #
# Replace template variables in a file with key/value pairs.                       #
# -------------------------------------------------------------------------------- #

# -------------------------------------------------------------------------------- #
# Replace Variables                                                                #
# -------------------------------------------------------------------------------- #
# Replace each search string with its replacement.                                 #
# -------------------------------------------------------------------------------- #

function replace_variables()
{
    local filename="$1"
    shift

    if (( $# % 2 != 0 )); then
        echo "replace_variables: expected pairs of <search> <replace>" 1>&2
        return 2
    fi

    while (( $# >= 2 )); do
        local search="$1"
        local replace="$2"
        shift 2

        if grep -q "${search}" "${filename}"; then
            sed -i '' "s/${search}/${replace}/g" "${filename}"
            printf "Replaced %s with %s\n" "${search}" "${replace}"
        fi
    done
}

# -------------------------------------------------------------------------------- #
# Run Tests                                                                        #
# -------------------------------------------------------------------------------- #
# A VERY simple test function to ensure that it all works                          #
# -------------------------------------------------------------------------------- #

function run_tests()
{
    local tmpfile

    tmpfile="$(mktemp -t variable-replace.XXXXXX)"
    cp "test.template" "${tmpfile}"

    replace_variables "${tmpfile}" \
        '{{ USERNAME_PLACE_HOLDER }}' 'admin' \
        '{{ PASSWORD_PLACE_HOLDER }}' 'password'

    rm -f "${tmpfile}"
}

# -------------------------------------------------------------------------------- #
# Main()                                                                           #
# -------------------------------------------------------------------------------- #
# This is the actual 'script' and the functions/sub routines are called in order.  #
# -------------------------------------------------------------------------------- #

run_tests "$@"

# -------------------------------------------------------------------------------- #
# End of Script                                                                    #
# -------------------------------------------------------------------------------- #
# This is the end - nothing more to see here.                                      #
# -------------------------------------------------------------------------------- #

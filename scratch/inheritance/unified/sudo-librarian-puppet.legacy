#!/usr/bin/env bash

set -euo pipefail

puppet_dir="/etc/puppetlabs/code/environments/production"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo "requires root: would run librarian-puppet install in ${puppet_dir}" >&2
    exit 0
fi

echo "noop: would run librarian-puppet install in ${puppet_dir}" >&2

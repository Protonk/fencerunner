{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fencerunner.dev/schemas/commitments_v1.json",
  "title": "Probe commitments registry (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commitments"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "commitments_v1"
    },
    "commitments": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitment" }
    }
  },
  "$defs": {
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "helps", "is", "at", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "provider": {
          "type": "string",
          "enum": ["runner", "system", "user"]
        },
        "helps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ensure", "detect", "emit"]
          }
        },
        "is": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"provider": {"const": "runner"}}
          },
          "then": {
            "properties": {
              "at": {
                "pattern": "^[^/].*$"
              }
            }
          }
        }
      ]
    }
  }
}
